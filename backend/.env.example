# OpenRouter API Configuration
# Get your free API key from https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Enable mock mode for testing (uses pre-defined responses instead of API)
# Useful when testing locally or if API key spending limit is exceeded
# Set to 'true' for demo mode, 'false' to use real API
USE_MOCK_MODE=false

# Flask Configuration (optional)
FLASK_ENV=development
FLASK_DEBUG=True
